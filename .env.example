# 复制为 .env 后按需修改
PORT=8080

# —— 数据源：改枪码大全（g.aitags.cn，公开免费）——
AITAGS_INTERVAL_MIN=10
# 主播同款（列表每轮 1 次请求，主播页仅在有更新时抓取）
AITAGS_STREAMER_INTERVAL_MIN=30

# —— 数据源：数据帝/小涛查开放平台（付费，按页扣资源）——
# 在 https://orzice.com/work/ 控制台开通「改枪码V2」后填入 token；留空则跳过该源
ORZICE_TOKEN=
ORZICE_INTERVAL_MIN=60
# 是否同时采集黑潮爆破改枪码（每页扣 2 次资源）
ORZICE_BLACKTIDE=0

# —— 手工录入（data/manual.json）——
MANUAL_INTERVAL_MIN=1

# 手动触发刷新：curl -X POST -H "Authorization: Bearer <ADMIN_TOKEN>" http://host/api/refresh
ADMIN_TOKEN=
